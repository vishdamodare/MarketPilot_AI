# Copy to backend/.env (backend) — never commit real values. Secrets stay server-side.
DATABASE_URL=postgresql+psycopg://localhost/marketpilot
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
COOKIE_SECURE=false            # true behind HTTPS

# PayPal (Sandbox by default). Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # live would be https://api-m.paypal.com (do not use until reviewed)
PAYPAL_WEBHOOK_ID=
# Only for PayPal-approved partners (multiparty payments / partner fees):
PAYPAL_PARTNER_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=

# Background sync (seconds; 0 = off, then run `python -m app.jobs` from cron)
SYNC_INTERVAL_SECONDS=900

# AI (optional: without a key the deterministic investigator answers using the same audited tools)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Frontend (frontend/.env.local)
BACKEND_URL=http://localhost:8010
